# Local development: no AWS account or real secret is required.
APP_MODE=local
API_PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
AWS_REGION=ap-southeast-1
DYNAMODB_TABLE=CloudLibraryWorkspace
DYNAMODB_ENDPOINT=http://127.0.0.1:8010
LOCAL_DATA_DIR=.local
LEGACY_DB_ROOT=../cloud-library-db
LEGACY_DYNAMODB_ENDPOINT=http://127.0.0.1:8001
VITE_API_BASE_URL=/api/v1
VITE_AUTH_MODE=local

# AWS: use the stack outputs, APP_MODE=aws, VITE_AUTH_MODE=cognito,
# and REMOVE DYNAMODB_ENDPOINT. Never put AWS access keys/passwords here.
CONTENT_BUCKET=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=
BEDROCK_MODEL_ID=
BEDROCK_KNOWLEDGE_BASE_ID=
BEDROCK_DATA_SOURCE_ID=
SES_FROM_EMAIL=
AZURE_SPEECH_SECRET_ARN=
