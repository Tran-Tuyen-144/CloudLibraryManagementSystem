{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Cloud Library: Chạy toàn bộ dự án",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/dev.mjs",
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "internalConsoleOptions": "openOnSessionStart",
      "autoAttachChildProcesses": false,
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
